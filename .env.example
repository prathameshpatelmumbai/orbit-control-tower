# ========================================================
# ORBIT: Autonomous Data Operations Control Tower Environment
# ========================================================

# General & Environment
PROJECT_NAME="ORBIT"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# API & Server
API_HOST="0.0.0.0"
API_PORT=8000
API_V1_STR="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Frontend Web
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/ws/events"

# PostgreSQL + pgvector
POSTGRES_USER="orbit_admin"
POSTGRES_PASSWORD="orbit_secret_password"
POSTGRES_DB="orbit_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://orbit_admin:orbit_secret_password@localhost:5432/orbit_db"

# Redis Streams & Cache
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# DuckDB Analytics Engine
DUCKDB_PATH="./storage/orbit_analytics.duckdb"

# LLM & Multi-Agent Keys (Optional for local simulation, active for live agents)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# MLflow Tracking
MLFLOW_TRACKING_URI="http://localhost:5000"
MLFLOW_EXPERIMENT_NAME="orbit_anomaly_forecasting"

# Dagster Home
DAGSTER_HOME="./storage/.dagster"
